{
  "name": "reisli",
  "version": "1.3.0",
  "description": "Reisli – Ferienbudget als Web-App (PWA) – lokal oder auf einer Synology NAS betreibbar",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "import-excel": "node scripts/import-excel.js",
    "test": "node --test test/*.test.js",
    "privacy": "node scripts/privacy-check.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=server/** --test-coverage-include=public/js/calc.js --test-coverage-include=public/js/booking-parse.js --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 test/*.test.js test/e2e/*.test.js"
  },
  "license": "MIT"
}
