{
  "name": "Reisli – Ferienbudget",
  "short_name": "Reisli",
  "description": "Reisen planen, Kosten im Griff, unterwegs erfassen",
  "lang": "de-CH",
  "start_url": "/#plan",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f3ee",
  "theme_color": "#0e6b6e",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Ausgabe erfassen",
      "url": "/#erfassen"
    },
    {
      "name": "Reiseplan",
      "url": "/#plan"
    },
    {
      "name": "Buchung importieren",
      "url": "/#import"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "message/rfc822", "application/vnd.ms-outlook", ".msg",
            ".eml",
            "text/plain",
            ".txt",
            "text/html",
            ".html"
          ]
        }
      ]
    }
  }
}